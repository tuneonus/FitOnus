# Copy to admin/.env.local for local Next.js development.
# On Vercel, configure NEXT_PUBLIC_API_URL per environment (Preview -> Render DEV, Production -> Render PROD).
# WARNING: NEXT_PUBLIC_* variables are bundled into client-side browser JavaScript.
# NEVER put secrets, database URLs, JWT secrets, or Gemini API keys here.

NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1/admin
