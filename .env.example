# FitOnus Mobile Environment Variables
# For local physical device testing with Expo Go, use your workstation LAN IP (e.g. http://192.168.1.100:3000/api/v1)
# For emulator/simulator testing, use http://localhost:3000/api/v1 (iOS) or http://10.0.2.2:3000/api/v1 (Android)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
