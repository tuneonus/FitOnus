# ==========================================
# FitOnus Monorepo Root Git Ignore
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.*

# Build Outputs
dist/
build/
.next/
out/
web-build/

# Expo / React Native
.expo/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*

# Environment files: NEVER commit live secrets or local credentials
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Logs and debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/

# TypeScript & Build Caches
*.tsbuildinfo
.turbo/
.cache/

# Local databases & test coverage
coverage/
*.sqlite
pgdata/
