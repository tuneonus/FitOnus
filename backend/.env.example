# Copy to .env for local development. Every value here is a placeholder.
# Production refuses placeholder secrets ("change-me"), http CORS origins and an unset AUTH_PUBLIC_REGISTRATION.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=true
# Number of reverse-proxy hops in front of the app (0 = direct). Affects client IPs and rate limiting.
TRUST_PROXY=0
BODY_LIMIT=100kb
# Comma-separated browser origins allowed by CORS. Never "*".
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL (compose.yaml uses the POSTGRES_* values) ---
POSTGRES_DB=app_dev
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgres://app:change-me-local-only@localhost:5432/app_dev
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
# disable | require | verify-full (use verify-full in production)
DATABASE_SSL=disable

# --- Authentication ---
JWT_ACCESS_SECRET=change-me-access-token-secret-at-least-32-chars
HMAC_SECRET=change-me-different-hmac-secret-at-least-32-chars
JWT_ISSUER=generic-backend
JWT_AUDIENCE=generic-backend-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Self-service sign-up. Keep false unless the product needs it.
AUTH_PUBLIC_REGISTRATION=false

# --- Rate limiting (per instance; see docs/deployment.md for multi-instance) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- Idempotency ---
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LEASE_SECONDS=60

# --- Development seed (npm run db:seed) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-local-admin-password
