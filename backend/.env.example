# Copy to backend/.env for local development. Every value here is a placeholder.
# Production (Render) refuses placeholder secrets ("change-me"), http CORS origins, LOG_PRETTY=true,
# and an unset AUTH_PUBLIC_REGISTRATION. Never commit real credentials or backups.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=true
# Number of reverse-proxy hops in front of the app (1 on Render/Cloudflare; 0 locally). Affects rate limiting.
TRUST_PROXY=0
SHUTDOWN_TIMEOUT_MS=10000
# Limit for standard JSON bodies. Base64 photo/audio routes declare their own per-route limits after auth.
BODY_LIMIT=100kb
# Comma-separated browser origins allowed by CORS. Never "*". Production requires https:// origins.
CORS_ORIGINS=http://localhost:3001,http://localhost:5173,https://fit-onus.vercel.app

# --- PostgreSQL (local Compose or Neon PostgreSQL) ---
# Local Docker Compose PostgreSQL defaults (used by backend/compose.yaml and root compose.yaml --profile local-db):
POSTGRES_DB=app_dev
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
# Local host connection:
DATABASE_URL=postgres://app:change-me-local-only@localhost:5432/app_dev
# Neon PostgreSQL example (uncomment and set DATABASE_SSL=verify-full or require):
# DATABASE_URL=postgresql://<role>:<password>@<ep-id>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=10000
# disable | require | verify-full (use verify-full or require for Neon and production)
DATABASE_SSL=disable

# --- Authentication ---
JWT_ACCESS_SECRET=change-me-access-token-secret-at-least-32-chars
HMAC_SECRET=change-me-different-hmac-secret-at-least-32-chars
JWT_ISSUER=generic-backend
JWT_AUDIENCE=generic-backend-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Self-service mobile/web sign-up. Must be set explicitly ("true" or "false") in production.
AUTH_PUBLIC_REGISTRATION=false

# --- Transactional e-mail (password reset). EMAIL_PROVIDER=none disables password reset (503). ---
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM="OnusFit <noreply@example.org>"
EMAIL_TIMEOUT_MS=5000

# --- Push notifications (FCM HTTP v1). Leave both FCM_SERVICE_ACCOUNT_* empty to keep push off. ---
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_BASE64=
FCM_PROJECT_ID=
FCM_DRY_RUN=false
FCM_REQUEST_TIMEOUT_MS=10000
NOTIFICATIONS_DISPATCHER_ENABLED=true
NOTIFICATIONS_POLL_INTERVAL_MS=10000
NOTIFICATIONS_MAX_ATTEMPTS=4
# Optional (>= 32 chars). Enables POST /api/v1/internal/notifications/dispatch for external cron.
NOTIFICATIONS_DISPATCH_SECRET=

# --- Cloudflare R2 public media bucket (set all five together or leave unset). ---
# Example bucket/origin when enabled: R2_BUCKET=fitonus-media, R2_PUBLIC_BASE_URL=https://media.tuneonus.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_REQUEST_TIMEOUT_MS=10000
IMAGE_HEIC_ENABLED=true

# --- Cloudflare R2 private member-media bucket (separate bucket & scoped token from public media). ---
# Requires R2_ACCOUNT_ID above. Leave all three R2_PRIVATE_* empty to disable private photos (503).
R2_PRIVATE_BUCKET=
R2_PRIVATE_ACCESS_KEY_ID=
R2_PRIVATE_SECRET_ACCESS_KEY=
PRIVATE_MEDIA_URL_TTL_SECONDS=900
PRIVATE_MEDIA_PURGE_ENABLED=true

# --- Rate limiting & idempotency (in-memory rate limit stores are per instance) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LEASE_SECONDS=60

# --- Maintenance & local seed (npm run db:cleanup / npm run db:seed) ---
SESSION_RETENTION_DAYS=30
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-local-admin-password

# --- AI configuration & Python AI backend (ai-backend/) ---
# Required to start the Node HTTP server. AI_BACKEND_SERVICE_SECRET must be >= 32 chars and equal
# AI_SERVICE_JWT_SECRET in ai-backend/.env.
AI_BACKEND_URL=http://127.0.0.1:8000
AI_BACKEND_SERVICE_SECRET=
AI_BACKEND_TIMEOUT_MS=25000
# Optional bootstrap defaults / admin key encryption override (falls back to HMAC_SECRET if unset):
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
AI_ENCRYPTION_KEY=
