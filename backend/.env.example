# Copy to .env for local development. Every value here is a placeholder.
# Production refuses placeholder secrets ("change-me"), http CORS origins and an unset AUTH_PUBLIC_REGISTRATION.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=true
# Number of reverse-proxy hops in front of the app (0 = direct). Affects client IPs and rate limiting.
TRUST_PROXY=0
# Limit of every JSON request body. Keep it small: the three AI routes that carry a base64 photo or audio clip declare
# their own bigger limit in code (read after sign-in), so this never needs raising for them. See docs/media.md.
BODY_LIMIT=100kb
# Comma-separated browser origins allowed by CORS. Never "*".
CORS_ORIGINS=http://localhost:5173,https://fit-onus.vercel.app

# --- PostgreSQL (compose.yaml uses the POSTGRES_* values) ---
POSTGRES_DB=app_dev
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgres://app:change-me-local-only@localhost:5432/app_dev
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
# disable | require | verify-full (use verify-full in production)
DATABASE_SSL=disable

# --- Authentication ---
JWT_ACCESS_SECRET=change-me-access-token-secret-at-least-32-chars
HMAC_SECRET=change-me-different-hmac-secret-at-least-32-chars
JWT_ISSUER=generic-backend
JWT_AUDIENCE=generic-backend-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Self-service sign-up. Keep false unless the product needs it.
AUTH_PUBLIC_REGISTRATION=false

# --- Transactional e-mail (password reset). EMAIL_PROVIDER=none (or unset) disables password reset: the endpoints answer 503.
# For Resend set EMAIL_PROVIDER=resend, EMAIL_API_KEY (secret, never commit) and EMAIL_FROM (a sender on a verified domain).
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM=OnusFit <noreply@example.org>
EMAIL_TIMEOUT_MS=5000

# --- Push notifications (FCM HTTP v1). See docs/notifications.md. Leaving the service account unset keeps push OFF:
# the inbox, preferences and device registration still work, but admins cannot send (503 PUSH_NOT_CONFIGURED).
# Supply the Firebase service-account key as raw JSON OR as base64 of that JSON (base64 survives dashboards that
# mangle newlines). It is a SECRET: set it in the host's secret store, never commit it, never prefix it EXPO_PUBLIC_.
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_BASE64=
# Optional: overrides project_id from the key file.
FCM_PROJECT_ID=
# true = FCM validates every message but delivers nothing. Use it to prove the wiring on DEV without notifying anyone.
FCM_DRY_RUN=false
FCM_REQUEST_TIMEOUT_MS=10000
# Run the polling timer inside this web process. Set false if a separate worker or cron drives dispatch instead.
# This does NOT stop sending: a "send now" still dispatches immediately (and sends everything that is due). To make a
# server unable to send, leave BOTH FCM_SERVICE_ACCOUNT_JSON and FCM_SERVICE_ACCOUNT_BASE64 empty, or set FCM_DRY_RUN=true.
NOTIFICATIONS_DISPATCHER_ENABLED=true
NOTIFICATIONS_POLL_INTERVAL_MS=10000
# Send attempts per device (first send included) before a delivery is marked failed.
NOTIFICATIONS_MAX_ATTEMPTS=4
# Optional (>= 32 chars). Enables POST /api/v1/internal/notifications/dispatch for an external scheduler
# (e.g. a Render cron job) via the X-Dispatch-Secret header. Unset = that endpoint answers 404.
NOTIFICATIONS_DISPATCH_SECRET=

# --- Notification images (Cloudflare R2, public media bucket). See docs/notifications.md "Notification images".
# Set ALL FIVE or NONE. None keeps image uploads OFF (503 IMAGE_STORAGE_NOT_CONFIGURED); text-only notifications are
# unaffected. R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY are SECRETS: set them in the host's secret store, never commit
# them, never prefix them NEXT_PUBLIC_/EXPO_PUBLIC_. The API token needs Object Read & Write on this one bucket only.
# The bucket is PUBLIC: only admin-authored artwork goes in, never a member's photo. Every image is stored as an
# optimized WebP under onusfit/<feature>/ with all metadata removed (see docs/notifications.md).
# Needs migrations 0021 AND 0022 applied to the database before the code is deployed.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fitonus-media
# Public https origin that serves the bucket (an R2 custom domain). Image URLs are built only from this.
R2_PUBLIC_BASE_URL=https://media.tuneonus.com
R2_REQUEST_TIMEOUT_MS=10000
# Uploads: JPEG, PNG, WebP and HEIC, up to 10 MiB and 8192 px a side. The 10 MiB limit is fixed in code and is separate
# from BODY_LIMIT (which only governs JSON bodies). HEIC (iPhone photos) is decoded with libheif-js, which is LGPL-3.0
# and whose HEVC decoding can carry patent-licensing obligations for a commercial service: set false to refuse HEIC
# uploads (415) while JPEG, PNG and WebP keep working.
IMAGE_HEIC_ENABLED=true

# --- Rate limiting (per instance; see docs/deployment.md for multi-instance) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- Idempotency ---
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LEASE_SECONDS=60

# --- Development seed (npm run db:seed) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-local-admin-password

# --- AI Coach chat: served ONLY by the Python AI backend (ai-backend/) ---
# Required to start the server. The URL is where `uvicorn` listens; the secret signs the short-lived
# service token and must equal AI_SERVICE_JWT_SECRET in ai-backend/.env (>= 32 random characters).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(36))"
# Details: docs/ai/learning/02-python-only-ai-architecture.md
AI_BACKEND_URL=http://127.0.0.1:8000
AI_BACKEND_SERVICE_SECRET=
# Optional: HTTP timeout for one call to Python, in ms (1000-28000, default 25000)
# AI_BACKEND_TIMEOUT_MS=25000
