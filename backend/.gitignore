# Dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Environment files: only the placeholder template is tracked
.env
.env.*
!.env.example

# Logs and OS/editor noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local database files (never commit data)
*.sqlite
pgdata/
backups/
*.dump
# SQL dumps and ad-hoc scripts stay out of git, but numbered migrations are source code: a migration that
# is not committed breaks every fresh database, CI run and deploy (0019 and 0020 were once lost this way).
# This file is deeper than the root .gitignore, so this exception also overrides the root `*.sql`.
*.sql
!migrations/*.sql
