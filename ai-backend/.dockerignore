.git
.github
.venv
venv
__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache
*.egg-info
dist
build
htmlcov
.coverage
tests
docs
.env
.env.*
!.env.example
*.log
.vscode
.idea
Dockerfile
.dockerignore
