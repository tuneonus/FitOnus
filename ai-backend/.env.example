# Copy to .env for local use. Real values are never committed (.env is gitignored).
ONUSFIT_AI_ENV=development

# Verifies the service token Node sends. At least 32 characters; must equal AI_BACKEND_SERVICE_SECRET
# in backend/.env. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(36))"
AI_SERVICE_JWT_SECRET=

# Google Gemini API key. Stays on the server; never sent to the mobile app.
GEMINI_API_KEY=

# Optional
# GEMINI_ATTEMPT_TIMEOUT_S=20
# AI_SERVICE_JWT_ISSUER=onusfit-node-api
# AI_SERVICE_JWT_AUDIENCE=onusfit-ai-backend
