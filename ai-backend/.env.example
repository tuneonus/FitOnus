# Copy to .env for local use. Real values are never committed (.env is gitignored).
# On Render these are set in the service's Environment tab, not in a file. See docs/render-deployment.md.

# development (default) | production. The Docker image sets production, which makes the service
# REFUSE TO START if the two required values below are missing or invalid.
ONUSFIT_AI_ENV=development

# --- Required -----------------------------------------------------------------------------------
# Verifies the service token the Node API sends. At least 32 characters. It must be IDENTICAL to
# AI_BACKEND_SERVICE_SECRET in the Node API's environment (backend/.env locally, Render env on prod).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(36))"
AI_SERVICE_JWT_SECRET=

# Google Gemini API key. Stays on this server; never sent to the app or to Node.
GEMINI_API_KEY=

# --- Optional (defaults shown) --------------------------------------------------------------------
# Port: Render sets PORT itself (default 10000); locally pass --port to uvicorn. Do not set it on Render.
# PORT=10000

# DEBUG | INFO | WARNING | ERROR | CRITICAL. Logs are metadata only: no prompts, user data, replies,
# images or keys, whatever the level.
# LOG_LEVEL=INFO

# Longest single Gemini attempt in seconds (0 < value <= 60). One attempt per model; Node's own
# deadlines (22 to 27 s per request) are shorter, so raising this rarely helps.
# GEMINI_ATTEMPT_TIMEOUT_S=20

# Token issuer/audience. Change only together with the Node API (they must match its constants).
# AI_SERVICE_JWT_ISSUER=onusfit-node-api
# AI_SERVICE_JWT_AUDIENCE=onusfit-ai-backend
