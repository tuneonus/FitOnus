# Copy to ai-backend/.env for local use. Real secrets must NEVER be committed (.env is gitignored).
# On Render, configure these in the service's Environment tab (marked as secrets).

# development (default) | production
# The Docker image sets ONUSFIT_AI_ENV=production, which refuses startup if required values are invalid.
ONUSFIT_AI_ENV=development

# --- Required -----------------------------------------------------------------------------------
# Shared HS256 secret verifying Node.js service tokens (>= 32 random characters).
# Must match AI_BACKEND_SERVICE_SECRET in backend/.env / Node service environment.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(36))"
AI_SERVICE_JWT_SECRET=

# Google Gemini API key. Server-side only; never exposed to mobile, admin, or Node logs.
# Leave unset during offline CI/tests to guarantee zero live Gemini API calls.
GEMINI_API_KEY=

# --- Runtime & Networking -----------------------------------------------------------------------
# Local uvicorn port (Render injects PORT, defaulting to 10000; do not set PORT in Render env).
# PORT=8000
# DEBUG | INFO | WARNING | ERROR | CRITICAL (logs contain metadata only, never prompts or user data)
LOG_LEVEL=INFO
# text (local dev) | json (Docker / Render production)
LOG_FORMAT=text
# Longest single Gemini call attempt in seconds (0 < value <= 60).
GEMINI_ATTEMPT_TIMEOUT_S=20

# Service-to-service JWT claims and Node internal-tools callback URL (overridden to http://api:3000 in Compose).
AI_SERVICE_JWT_ISSUER=onusfit-node-api
AI_SERVICE_JWT_AUDIENCE=onusfit-ai-backend
NODE_API_URL=http://127.0.0.1:3000

# --- Feature Flags (safe production defaults) ---------------------------------------------------
AI_COACH_CHAT_STRUCTURED_OUTPUTS=true
AI_COACH_CHAT_TOOLS=false
AI_COACH_INSIGHTS_STRUCTURED_OUTPUTS=true
AI_VOICE_MEAL_STRUCTURED_OUTPUTS=true
AI_PHOTO_MEAL_STRUCTURED_OUTPUTS=true
AI_SPEECH_STRUCTURED_OUTPUTS=true
COACH_AGENT_ENABLED=false
COACH_AGENT_ENGINE=langgraph
COACH_AGENT_GRAPH_FALLBACK=true
MCP_ENABLED=false
MCP_TRANSPORT=in_process
MCP_SERVER_URL=http://localhost:8000/internal/v1/mcp
MCP_DISCOVERY_TTL_SECONDS=300
MCP_TIMEOUT_SECONDS=5.0
