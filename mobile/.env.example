# Copy to mobile/.env for local development. Real credentials are never committed.
# WARNING: EXPO_PUBLIC_* values are embedded into the mobile app bundle. Never store secrets here.
#
# Environment separation:
#   - Local dev (Expo Go): http://<YOUR_LAN_IP>:3000/api/v1
#   - Preview / Internal Testing (EAS profile): https://fitonus-api-dev.onrender.com/api/v1
#   - Store Production (EAS profile): https://fitonus-api.onrender.com/api/v1 (via mobile/eas.json)
#   - Android FCM config (GOOGLE_SERVICES_JSON): supplied as an EAS file secret, never committed.

EXPO_PUBLIC_API_URL=https://fitonus-api-dev.onrender.com/api/v1
